{
  "name": "PhishLens",
  "description": "Detects phishing emails in Gmail and explains why: wording, links, sender checks, threat intelligence and attachments.",
  "version": "1.15.5",
  "manifest_version": 3,
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "PhishLens",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://anzouk.duckdns.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "lib/shared.js",
        "lib/lime_cache.js",
        "content_scripts/core.js",
        "content_scripts/banner.js",
        "content_scripts/gmail_scan.js",
        "content_scripts/attachments.js",
        "content_scripts/autoscan.js",
        "content_scripts/gmail.js"
      ],
      "css": [
        "content_scripts/banner.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "lib/shared.js",
        "lib/lime_cache.js",
        "content_scripts/core.js",
        "content_scripts/banner.js",
        "content_scripts/outlook.js"
      ],
      "css": [
        "content_scripts/banner.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
