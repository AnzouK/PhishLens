{
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "2.0.7",
  "manifest_version": 3,
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "PhishLens",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://phishlens.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "lib/locales/en.js",
        "lib/locales/fr.js",
        "lib/locales/pt.js",
        "lib/locales/es.js",
        "lib/locales/de.js",
        "lib/locales/it.js",
        "lib/locales/nl.js",
        "lib/locales/ha.js",
        "lib/i18n.js",
        "lib/shared.js",
        "lib/lime_cache.js",
        "lib/redact.js",
        "lib/report_ui.js",
        "content_scripts/core.js",
        "content_scripts/banner.js",
        "content_scripts/feedback.js",
        "content_scripts/gmail_scan.js",
        "content_scripts/attachments.js",
        "content_scripts/autoscan.js",
        "content_scripts/gmail.js"
      ],
      "css": [
        "content_scripts/banner.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "lib/locales/en.js",
        "lib/locales/fr.js",
        "lib/locales/pt.js",
        "lib/locales/es.js",
        "lib/locales/de.js",
        "lib/locales/it.js",
        "lib/locales/nl.js",
        "lib/locales/ha.js",
        "lib/i18n.js",
        "lib/shared.js",
        "lib/lime_cache.js",
        "lib/redact.js",
        "lib/report_ui.js",
        "content_scripts/core.js",
        "content_scripts/banner.js",
        "content_scripts/feedback.js",
        "content_scripts/outlook.js"
      ],
      "css": [
        "content_scripts/banner.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
