# =====================================================================
# PhishLens backend: Docker image
# =====================================================================
# Local image: `uvicorn extension_backend:app` on port 8000, with the
# text model mounted read-only at /app/model (see docker-compose.yml), so
# models can be swapped without rebuilding.
# =====================================================================

FROM python:3.12-slim AS base

# System dependencies
#   - build-essential: needed by some pip packages with C extensions
#   - curl: used by the HEALTHCHECK
#   - tesseract-ocr: OCR for images and scanned PDFs, with language packs
#   - libarchive-tools: bsdtar, decompresses RAR members
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        tesseract-ocr \
        tesseract-ocr-fra tesseract-ocr-spa tesseract-ocr-por tesseract-ocr-deu tesseract-ocr-ita tesseract-ocr-nld tesseract-ocr-rus tesseract-ocr-ukr tesseract-ocr-ara tesseract-ocr-chi-sim tesseract-ocr-jpn tesseract-ocr-kor tesseract-ocr-hin \
        libarchive-tools \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (better layer caching).
# torch is installed from the CPU-only index: the default wheels ship
# with ~3.5 GB of NVIDIA CUDA runtime that's useless on CPU hosts.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.0,<3.0" \
 && pip install --no-cache-dir -r requirements.txt

# App code: every top-level module of backend/ (tests/ is not copied).
COPY *.py ./

# Where the text model checkpoint is mounted
ENV MODEL_DIR=/app/model
ENV PYTHONUNBUFFERED=1
ENV TRANSFORMERS_OFFLINE=1
ENV HF_HUB_OFFLINE=1

EXPOSE 8000

# GET / answers {"status": "ok"} once the server is up
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -fsS http://localhost:8000/ || exit 1

CMD ["uvicorn", "extension_backend:app", "--host", "0.0.0.0", "--port", "8000"]
