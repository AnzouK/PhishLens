# =====================================================================
# PhishLens backend: cloud deployment image (Oracle Cloud / any Docker host).
# =====================================================================
# Differences from the local backend Dockerfile:
#   - listens on $PORT (HF Spaces inject 7860 by default)
#   - runs as a non-root user (HF requirement)
#   - does NOT bundle the DistilBERT checkpoint into the image; it is
#     downloaded from HF Hub on first run (HF_MODEL_REPO).
# =====================================================================

FROM python:3.12-slim

# System packages for attachment analysis (v1.12):
#   - tesseract-ocr: OCR for images and scanned PDFs (English data included)
#   - libarchive-tools (v1.15.3): bsdtar, used by rarfile to decompress
#     the members of RAR attachments (the listing itself is pure Python)
# Installed as root, before switching to the unprivileged user.
RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr libarchive-tools \
 && rm -rf /var/lib/apt/lists/*

# Run as user 1000, not root.
RUN useradd -m -u 1000 user
USER user
ENV PATH=/home/user/.local/bin:$PATH
WORKDIR /home/user/app

# Caches must be writable by user 1000.
ENV HF_HOME=/home/user/.cache/huggingface \
    PYTHONUNBUFFERED=1 \
    MODEL_DIR=/home/user/app/model

# Install Python dependencies.
COPY --chown=user:user requirements.txt .
# torch first, from the CPU-only wheel index: skips ~3.5 GB of NVIDIA CUDA
# runtime packages that ship as hard deps of the default torch 2.14+ wheels.
# The Oracle Cloud ARM VM has no GPU, so those packages are pure bloat.
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.0,<3.0" \
 && pip install --no-cache-dir -r requirements.txt

# Application code: every top-level module of backend/ (tests/ and
# scripts are not copied). Same set as Dockerfile.local.
COPY --chown=user:user *.py ./

# HF Spaces sets PORT=7860 by default; honour it.
ENV PORT=7860
EXPOSE 7860

# Use sh -c so the shell can expand $PORT.
CMD ["sh", "-c", "uvicorn extension_backend:app --host 0.0.0.0 --port ${PORT:-7860}"]
